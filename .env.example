# PostgreSQL connection used by Prisma.
# Copy this file to .env and replace the local values with your development credentials.
DATABASE_URL="postgresql://chantier360:change-me@localhost:5432/chantier360?schema=public"
PORT=3000
JWT_SECRET="replace-with-a-long-random-development-secret"
# Il n'y a pas encore de refresh token : gardez cette durée alignée sur
# SESSION_MAX_AGE_SECONDS côté web (cookie de session du back-office).
JWT_ACCESS_EXPIRES_IN="8h"
SEED_DEMO_PASSWORD="Chantier360!2026"
